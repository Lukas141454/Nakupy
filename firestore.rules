rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Každý vidí jen svůj profil (ve kterém seznamu je)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /lists/{listId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.resource.data.members == [request.auth.uid];
      // Člen může cokoli; kdo má pozvánku (zná ID), se může jen PŘIDAT mezi členy
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid]))
      );

      match /items/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(db)/documents/lists/$(listId)).data.members;
      }
    }
  }
}
